# Code Minder Backend Configuration

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
# In development, if MongoDB daemon is not running, Code Minder will automatically start an embedded in-memory MongoDB instance
MONGODB_URI=mongodb://localhost:27017/codeminder

# JWT Authentication Secrets
JWT_SECRET=code_minder_super_secure_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# CORS Client URL
CLIENT_URL=http://localhost:5173

# Google Gemini API Key
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Contest Aggregator APIs (Optional keys for external services)
# Kontests and Clist endpoints work out-of-the-box or fall back seamlessly
CLIST_API_KEY=
CLIST_USER_NAME=
